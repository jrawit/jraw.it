{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "prettier.config.js"
  ],
  "extends": "expo/tsconfig.base"
}
